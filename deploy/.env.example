# 复制成 deploy/.env 后修改
# 注意：所有带 【必填】 的都要改，否则 compose 会拒绝启动（这是故意的）

# 【必填】数据库密码
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_USER=riji
POSTGRES_DB=riji

# 【必填】签发登录令牌用的密钥，至少 32 位随机字符
# 生成方法：openssl rand -base64 32
RJJ_JWT_SECRET=please-generate-a-random-32-byte-secret

# 节点身份
RJJ_NODE_ID=node-1
RJJ_NODE_ROLE=primary

# 对外端口（前面还应有一层反向代理做 TLS）
RJJ_PORT=8080
RJJ_TLS_PORT=9443

# 多节点：作为副本时填主节点的 mTLS 地址
# RJJ_PRIMARY_URL=https://api-1.example.com:9443
# RJJ_TLS_DIR=/certs

# 节点间共享令牌（启用 mTLS 后仅作第二道校验）
# RJJ_REPLICATION_TOKEN=please-generate-another-secret

TZ=Asia/Shanghai
