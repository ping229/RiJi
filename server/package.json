{
  "name": "riji-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RiJi diary platform server (node API, sync engine, admin API)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "set-password": "tsx scripts/set-password.ts",
    "certs": "tsx scripts/certs.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "node-forge": "^1.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
